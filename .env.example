# Copy to .env and fill in what you need. Not required for basic local dev.
# See README.md for what's required in production.

# SECRET_KEY_BASE=
# PRIMARY_DATABASE_URL=   # not needed if deploying from the Rails 8 Railway template
# CACHE_DATABASE_URL=     # not needed if deploying from the Rails 8 Railway template
# QUEUE_DATABASE_URL=     # not needed if deploying from the Rails 8 Railway template
# CABLE_DATABASE_URL=     # not needed if deploying from the Rails 8 Railway template
# APP_HOST=
# POSTMARK_API_TOKEN=
# MAIL_PROVIDER=            # "postmark" (default) or "brevo" (backup)
# BREVO_API_KEY=
# MAIL_FROM_ADDRESS=       # defaults to noreply@rockymtnruby.dev; must be a sender verified with whichever MAIL_PROVIDER is active
# MISSION_CONTROL_USER=
# MISSION_CONTROL_PASSWORD=
# TITO_API_TOKEN=
# TITO_ACCOUNT_SLUG=
# TITO_EVENT_SLUG=

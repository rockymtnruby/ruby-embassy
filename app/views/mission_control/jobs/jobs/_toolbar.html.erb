<%# Host-app override of mission_control-jobs 1.1.0's
  # app/views/mission_control/jobs/jobs/_toolbar.html.erb (engine views resolve
  # to the host app first). Byte-identical to the engine partial except for the
  # "Clear finished" button below. If the gem is upgraded, diff this against
  # the new engine partial and re-apply the addition. %>
<div class="buttons is-right level-right">
  <% if active_filters? %>
    <span class="mr-5">
      <%= jobs_count %> jobs found
    </span>
  <% end %>

  <% if jobs_status.failed? %>
    <% target = active_filters? ? "selection" : "all" %>

    <%= button_to "Discard #{target}", application_bulk_discards_path(@application, **jobs_filter_param),
      method: :post, disabled: jobs_count == 0, class: "button is-danger is-light",
      form: { data: { turbo_confirm: "This will delete #{jobs_count} jobs and can't be undone. Are you sure?" } } %>
    <%= button_to "Retry #{target}", application_bulk_retries_path(@application, **jobs_filter_param),
      method: :post, disabled: jobs_count == 0,
      class: "button is-warning is-light mr-0" %>
  <% end %>

  <%# App addition: on-demand finished-jobs cleanup (replaces the old hourly
    recurring task — see commented entry in config/recurring.yml). Only shown
    on the finished tab. Engine Bulma classes, engine confirm pattern. %>
  <% if jobs_status&.finished? %>
    <%= button_to "Clear finished", main_app.admin_clear_finished_jobs_path,
      method: :post, disabled: jobs_count == 0, class: "button is-danger is-light",
      form: { data: { turbo_confirm: "This will delete #{jobs_count} finished jobs and can't be undone. Are you sure?" } } %>
  <% end %>
</div>

<% content_for :title, "Edit Swag — Embassy Admin" %>

<h1 class="text-2xl font-bold text-navy mb-1">Swag for <%= @handoff.user.full_name %></h1>
<p class="text-muted mb-6"><%= @handoff.user.email %></p>

<% if @handoff.errors.any? %>
  <div class="alert alert-error mb-4">
    <ul class="list-disc">
      <% @handoff.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card card-compact">
  <%= form_with model: @handoff,
                url: admin_shirt_handoff_path(@handoff, q: params[:q], status: params[:status]),
                local: true,
                class: "space-y-4" do |f| %>
    <div>
      <%= f.label :size, class: "label" %>
      <% size_options = ShirtHandoff::SIZES.dup %>
      <% size_options |= [ @handoff.size ] if @handoff.size.present? %>
      <%= f.select :size,
            [["No answer", ""]] + size_options.map { |s| [s, s] },
            {}, class: "select" %>
    </div>

    <div>
      <%= f.label :status, class: "label" %>
      <%= f.select :status,
            ShirtHandoff.statuses.keys.map { |s| [s.humanize, s] },
            {}, class: "select" %>
      <p class="text-muted text-sm mt-1">
        Waitlist = late purchase, on hold for leftovers. Missed = wrong size, out of stock, or no-show — say why in the note.
      </p>
    </div>

    <div>
      <%= f.label :note, "Note", class: "label" %>
      <%= f.text_area :note, rows: 3, class: "input",
                      placeholder: "e.g., Gave 2XL instead of XL — ran out of L. Picked up by a friend." %>
    </div>

    <div class="flex gap-3 pt-4 flex-wrap">
      <%= f.submit "Save", class: "btn btn-navy" %>
      <%= link_to "Cancel", admin_shirt_handoffs_path(q: params[:q], status: params[:status]), class: "btn btn-muted" %>
    </div>
  <% end %>
</div>
